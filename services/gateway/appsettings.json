{
  "ReverseProxy": {
    "Routes": {
      "orders": {
        "ClusterId": "orders",
        "Match": {
          "Path": "/orders/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/orders"
          }
        ]
      },
      "products": {
        "ClusterId": "products",
        "Match": {
          "Path": "/products/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/products"
          }
        ]
      },
      "users": {
        "ClusterId": "users",
        "Match": {
          "Path": "/users/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/users"
          }
        ]
      },
      "inventory": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/inventory/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/inventory"
          }
        ]
      },
      "cart": {
        "ClusterId": "cart",
        "Match": {
          "Path": "/cart/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/cart"
          }
        ]
      },
      "payments": {
        "ClusterId": "payments",
        "Match": {
          "Path": "/payments/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/payments"
          }
        ]
      }
    },
    "Clusters": {
      "orders": {
        "Destinations": {
          "orders-api": {
            "Address": "http://orders-api:8080/"
          }
        }
      },
      "products": {
        "Destinations": {
          "products-api": {
            "Address": "http://products-api:8080/"
          }
        }
      },
      "users": {
        "Destinations": {
          "users-api": {
            "Address": "http://users-api:8080/"
          }
        }
      },
      "inventory": {
        "Destinations": {
          "inventory-api": {
            "Address": "http://inventory-api:8080/"
          }
        }
      },
      "cart": {
        "Destinations": {
          "cart-api": {
            "Address": "http://cart-api:8080/"
          }
        }
      },
      "payments": {
        "Destinations": {
          "payments-api": {
            "Address": "http://payments-api:8080/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
